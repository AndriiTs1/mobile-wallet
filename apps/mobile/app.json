{
  "expo": {
    "name": "Mobile Wallet",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.swisswallet.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to protect access to your wallet and sensitive actions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0F",
          "image": "./assets/images/shield-mark@3x.png",
          "imageWidth": 90
        }
      ],
      "./plugins/withWalletCoreBridgeTestSpec.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c273083-2f82-4aac-9cd7-0f64bc781bc1"
      }
    },
    "owner": "andriitsiurupa"
  }
}
